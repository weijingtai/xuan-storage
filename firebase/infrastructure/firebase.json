{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions-py",
      "codebase": "python",
      "runtime": "python311",
      "ignore": [
        "venv",
        ".venv",
        "__pycache__",
        "*.pyc",
        ".pytest_cache",
        "tests",
        "tools",
        ".gitignore"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
